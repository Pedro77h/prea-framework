# Profile: loads internal/config/application-<profile>.yaml over application.yaml
PREA_PROFILE='dev'
# Referenced by the yaml as ${DATABASE_URL} and ${JWT_SECRET}
DATABASE_URL='postgresql://user:pass@host:port/dbname'
# 32+ random bytes, e.g.: openssl rand -base64 32
JWT_SECRET='SEGREDO_COM_PELO_MENOS_32_BYTES_AQUI'
